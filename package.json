{
  "name": "certiforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm prisma migrate dev",
    "db:push": "pnpm prisma db push",
    "db:seed": "pnpm tsx prisma/seed.ts",
    "db:studio": "pnpm prisma studio",
    "worker": "pnpm --filter worker dev"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0",
    "@playwright/test": "^1.48.0"
  },
  "packageManager": "pnpm@10.12.0"
}
