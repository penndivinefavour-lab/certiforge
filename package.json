{
  "name": "certiforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --filter web dev",
    "build": "pnpm -r --filter @certiforge/* build && pnpm --filter web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r --filter @certiforge/* typecheck && pnpm --filter web typecheck",
    "lint": "oxlint",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "@vitest/ui": "^1.6.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^1.6.1"
  },
  "packageManager": "pnpm@10.12.0",
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  }
}
