{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@certiforge/open-studio": ["../../packages/open-studio/src/index.ts"],
      "@certiforge/open-studio/*": ["../../packages/open-studio/src/*"],
      "@certiforge/certificate-engine": ["../../packages/certificate-engine/src/index.ts"],
      "@certiforge/certificate-engine/*": ["../../packages/certificate-engine/src/*"],
      "@certiforge/qr": ["../../packages/qr/src/index.ts"],
      "@certiforge/qr/*": ["../../packages/qr/src/*"],
      "@certiforge/types": ["../../packages/types/src/index.ts"],
      "@certiforge/types/*": ["../../packages/types/src/*"],
      "@certiforge/pdf-engine": ["../../packages/pdf-engine/src/index.ts"],
      "@certiforge/pdf-engine/*": ["../../packages/pdf-engine/src/*"],
      "@certiforge/validation": ["../../packages/validation/src/index.ts"],
      "@certiforge/validation/*": ["../../packages/validation/src/*"],
      "@certiforge/editor": ["../../packages/editor/src/index.ts"],
      "@certiforge/editor/*": ["../../packages/editor/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
