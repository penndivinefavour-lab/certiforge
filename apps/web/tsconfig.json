{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "open-studio": ["../../packages/open-studio/src/index.ts"],
      "open-studio/*": ["../../packages/open-studio/src/*"],
      "certificate-engine": ["../../packages/certificate-engine/src/index.ts"],
      "certificate-engine/*": ["../../packages/certificate-engine/src/*"],
      "qr": ["../../packages/qr/src/index.ts"],
      "qr/*": ["../../packages/qr/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
