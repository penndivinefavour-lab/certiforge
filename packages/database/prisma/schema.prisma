// This is the CertiForge database schema.
// Supports both SQLite (development) and PostgreSQL (production).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USERS
// ============================================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String   // bcrypt hashed
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMember[]
  sessions     Session[]
  apiKeys      ApiKey[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  name      String
  key       String   @unique
  lastUsed  DateTime?
  createdAt DateTime @default(now())
  expiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

// ============================================================================
// ORGANIZATIONS
// ============================================================================

model Organization {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  logoUrl           String?
  primaryColor      String   @default("#1a1a2e")
  verificationDomain String?  // custom domain for verification pages

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    OrganizationMember[]
  projects   Project[]
  recipients Recipient[]
  assets     Asset[]
  auditLogs  AuditLog[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId        String
  role          Role     @default(VIEWER)
  createdAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

// ============================================================================
// PROJECTS
// ============================================================================

model Project {
  id          String       @id @default(cuid())
  organizationId String
  name        String
  slug        String
  state       ProjectState @default(DRAFT)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templates   Template[]
  recipients  Recipient[]
  certificates Certificate[]
  generationJobs GenerationJob[]
  imports     RecipientImport[]
  certificateSequences CertificateSequence[]
  auditLogs    AuditLog[]

  @@unique([organizationId, slug])
  @@map("projects")
}

enum ProjectState {
  DRAFT
  ACTIVE
  ARCHIVED
}

// ============================================================================
// TEMPLATES
// ============================================================================

model Template {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  format      TemplateFormat @default(PDF)
  status      TemplateStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions    TemplateVersion[]
  elements    TemplateElement[]

  @@map("templates")
}

enum TemplateFormat {
  PDF
  PNG
  JPG
  WEBP
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
}

model TemplateVersion {
  id          String   @id @default(cuid())
  templateId  String
  version     Int
  name        String?

  // Canvas settings
  width       Float
  height      Float
  backgroundColor String @default("#ffffff")
  orientation Orientation @default(PORTRAIT)

  // Serialized editor state (JSON string)
  elements   String   // JSON array of template elements
  background String?  // background image URL or gradient config

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template     Template             @relation(fields: [templateId], references: [id], onDelete: Cascade)
  certificates Certificate[]

  @@unique([templateId, version])
  @@map("template_versions")
}

enum Orientation {
  PORTRAIT
  LANDSCAPE
}

model TemplateElement {
  id          String   @id @default(cuid())
  templateId  String
  versionId   String

  type        ElementType
  name        String   @default("Element")
  zIndex      Int      @default(0)

  // Position
  x           Float
  y           Float
  width       Float
  height      Float
  rotation    Float    @default(0)

  // Common styles
  opacity     Float    @default(1)
  visible     Boolean  @default(true)
  locked      Boolean  @default(false)

  // Element-specific data (JSON string)
  // For TEXT: fontFamily, fontSize, fontWeight, color, textAlign, lineHeight, letterSpacing, text, dynamicField
  // For IMAGE: assetId, src, fit
  // For SHAPE: shapeType, fillColor, strokeColor, strokeWidth
  // For QR: verificationUrl, size
  data        String   // JSON string

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template     Template?             @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@map("template_elements")
}

enum ElementType {
  TEXT
  IMAGE
  SHAPE
  LINE
  QR_CODE
  SIGNATURE
  SEAL
}

// ============================================================================
// RECIPIENTS
// ============================================================================

model Recipient {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  externalId     String?

  name           String
  email          String?

  // Flexible metadata for custom fields
  metadata       String   @default("{}") // JSON string

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  certificates Certificate[]
  importRows   RecipientImportRow[]

  @@index([organizationId])
  @@index([projectId])
  @@map("recipients")
}

model RecipientImport {
  id          String   @id @default(cuid())
  projectId   String
  fileName    String
  fileType    String   // CSV, XLSX
  totalRows   Int
  validRows   Int
  invalidRows Int
  status      ImportStatus @default(COMPLETED)
  error       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rows        RecipientImportRow[]
  mapping     RecipientMapping?

  @@map("recipient_imports")
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model RecipientImportRow {
  id              String   @id @default(cuid())
  importId        String
  rowNumber       Int
  rawData         String   // JSON string of all columns
  status          RowStatus @default(VALID)
  errors          String?  // JSON array of error messages
  recipientId     String?

  createdAt       DateTime @default(now())

  import    RecipientImport    @relation(fields: [importId], references: [id], onDelete: Cascade)
  recipient Recipient?         @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@map("recipient_import_rows")
}

enum RowStatus {
  VALID
  INVALID
  DUPLICATE
  SKIPPED
}

model RecipientMapping {
  id            String   @id @default(cuid())
  importId      String   @unique

  // Map spreadsheet columns to certificate fields
  recipientName     String? // column name → recipient name
  courseName        String?
  issueDate         String?
  instructor        String?
  organization      String?
  duration          String?
  grade             String?
  email             String?
  customFields      String? // JSON: { "custom_field_name": "column_name" }

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  import        RecipientImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@map("recipient_mappings")
}

// ============================================================================
// CERTIFICATE SEQUENCES
// ============================================================================

model CertificateSequence {
  id            String   @id @default(cuid())
  projectId     String
  year          Int
  nextNumber    Int      @default(1)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, year])
  @@map("certificate_sequences")
}

// ============================================================================
// CERTIFICATES
// ============================================================================

model Certificate {
  id               String      @id @default(cuid())
  projectId        String
  recipientId      String
  templateVersionId String
  certificateNumber String     @unique
  verificationToken String     @unique
  status           CertificateStatus @default(DRAFT)

  issuedAt         DateTime?
  revokedAt        DateTime?
  revocationReason String?

  pdfUrl           String?
  qrUrl            String?
  qrDataUrl        String?     // base64 QR for preview

  metadata         String      @default("{}") // JSON

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recipient        Recipient   @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  templateVersion  TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  events           CertificateEvent[]
  generationJobItems GenerationJobItem[]

  @@index([projectId])
  @@index([certificateNumber])
  @@index([status])
  @@map("certificates")
}

enum CertificateStatus {
  DRAFT
  GENERATED
  ISSUED
  REVOKED
}

model CertificateEvent {
  id           String           @id @default(cuid())
  certificateId String
  eventType    CertificateEventType
  actorId      String?          // user who performed the action
  metadata     String           @default("{}")
  createdAt    DateTime         @default(now())

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId])
  @@map("certificate_events")
}

enum CertificateEventType {
  CREATED
  GENERATED
  ISSUED
  DOWNLOADED
  EMAILED
  VERIFIED
  REVOKED
  REGENERATED
}

// ============================================================================
// GENERATION JOBS
// ============================================================================

model GenerationJob {
  id           String           @id @default(cuid())
  projectId    String
  status       GenerationJobStatus @default(QUEUED)
  total        Int
  completed    Int              @default(0)
  failed       Int              @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  outputUrl    String?
  error        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items        GenerationJobItem[]

  @@index([projectId])
  @@map("generation_jobs")
}

enum GenerationJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  PARTIAL_FAILURE
  FAILED
  CANCELLED
}

model GenerationJobItem {
  id             String   @id @default(cuid())
  generationJobId String
  certificateId  String
  status         JobItemStatus @default(PENDING)
  attempts       Int      @default(0)
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  generationJob GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  certificate    Certificate  @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@unique([generationJobId, certificateId])
  @@map("generation_job_items")
}

enum JobItemStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

// ============================================================================
// ASSETS
// ============================================================================

model Asset {
  id          String   @id @default(cuid())
  organizationId String
  name        String
  type        AssetType
  mimeType    String
  size        Int
  url         String
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("assets")
}

enum AssetType {
  LOGO
  SIGNATURE
  SEAL
  BACKGROUND
  IMAGE
}

// ============================================================================
// AUDIT LOGS
// ============================================================================

model AuditLog {
  id           String   @id @default(cuid())
  organizationId String
  projectId    String?
  actorId      String?  // user who performed the action
  action       String   // e.g. "PROJECT_CREATED", "CERTIFICATE_REVOKED"
  resourceType String   // e.g. "project", "certificate"
  resourceId   String
  details      String   @default("{}") // JSON
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
  @@map("audit_logs")
}

// ============================================================================
// VERIFICATION EVENTS (public-facing, lightweight)
// ============================================================================

model VerificationEvent {
  id              String   @id @default(cuid())
  certificateNumber String
  token           String
  verifiedAt      DateTime @default(now())
  ipHash          String?  // hashed IP, not raw

  @@index([certificateNumber])
  @@map("verification_events")
}
