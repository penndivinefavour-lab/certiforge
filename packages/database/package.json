{
  "name": "@certiforge/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./auth": {
      "import": "./dist/auth.js",
      "require": "./dist/auth.cjs",
      "types": "./dist/auth.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "require": "./dist/client.cjs",
      "types": "./dist/client.d.ts"
    },
    "./organizations": {
      "import": "./dist/organizations.js",
      "require": "./dist/organizations.cjs",
      "types": "./dist/organizations.d.ts"
    },
    "./recipients": {
      "import": "./dist/recipients.js",
      "require": "./dist/recipients.cjs",
      "types": "./dist/recipients.d.ts"
    },
    "./certificates": {
      "import": "./dist/certificates.js",
      "require": "./dist/certificates.cjs",
      "types": "./dist/certificates.d.ts"
    },
    "./generation": {
      "import": "./dist/generation.js",
      "require": "./dist/generation.cjs",
      "types": "./dist/generation.d.ts"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "seed": "tsx seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0"
  }
}
